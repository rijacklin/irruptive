API_HOST=0.0.0.0
API_PORT=3000
POSTGRES_PORT=5432
DATABASE_URL=postgresql://irruptive:irruptive@localhost:5432/irruptive
TEST_DATABASE_URL=postgresql://irruptive:irruptive@localhost:5432/irruptive_test
