# Copy to .env for local development. The API, sqlx-cli, the sqlx query
# macros, and #[sqlx::test] all read DATABASE_URL from here.
API_HOST=0.0.0.0
API_PORT=3000

# Rust-rewrite PostgreSQL (docker-compose.yml). Port 5433 avoids the
# TypeScript app's database on 5432.
POSTGRES_PORT=5433
DATABASE_URL=postgresql://irruptive:irruptive@localhost:5433/irruptive

# Logging: RUST_LOG uses tracing EnvFilter syntax; LOG_FORMAT=json for structured logs.
RUST_LOG=info,irruptive_api=debug,tower_http=debug
LOG_FORMAT=
