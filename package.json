{
  "name": "irruptive",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "db:create-migration": "npm run migration:create --workspace @irruptive/database --",
    "db:migrate": "npm run migration:up --workspace @irruptive/database",
    "db:rollback": "npm run migration:down --workspace @irruptive/database",
    "db:redo": "npm run migration:redo --workspace @irruptive/database",
    "db:test:migrate": "npm run migration:test:up --workspace @irruptive/database",
    "dev": "npm run dev --workspace @irruptive/api",
    "dev:api": "npm run dev --workspace @irruptive/api",
    "dev:web": "npm run dev --workspace @irruptive/web",
    "dev:worker": "npm run dev --workspace @irruptive/worker",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify": "npm run format && npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "verify:integration": "npm run db:test:migrate && npm run verify"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^24.2.1",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4"
  }
}
