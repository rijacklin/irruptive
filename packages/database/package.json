{
  "name": "@irruptive/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "migration:create": "node-pg-migrate create --migration-file-language sql --migration-filename-format utc --migrations-dir migrations",
    "migration:up": "node-pg-migrate up --migrations-dir migrations --envPath ../../.env",
    "migration:down": "node-pg-migrate down --migrations-dir migrations --envPath ../../.env",
    "migration:redo": "node-pg-migrate redo --migrations-dir migrations --envPath ../../.env",
    "migration:test:up": "node-pg-migrate up --migrations-dir migrations --envPath ../../.env --database-url-var TEST_DATABASE_URL",
    "test": "vitest run test"
  },
  "dependencies": {
    "@irruptive/shared": "*",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "dotenv": "^17.4.2",
    "node-pg-migrate": "^9.0.0",
    "vitest": "^3.2.7"
  }
}
